// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id              String     @id @default(cuid())
  name            String
  initials        String
  title           String
  location        String
  phone           String?
  rating          Float      @default(0)
  reviewCount     Int        @default(0)
  isFeatured      Boolean    @default(false)
  isVerified      Boolean    @default(false)
  avatar          String?
  bio             String?
  yearsExperience Int?
  specializations String[]
  email           String     @unique
  password        String
  role            String     @default("AGENT") // AGENT, ADMIN, CUSTOMER
  properties      Property[]
  inquiries       Inquiry[]
  blogPosts       BlogPost[]
  favorites       Favorite[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Favorite {
  id         String   @id @default(cuid())
  customer   Agent    @relation(fields: [customerId], references: [id])
  customerId String
  propertyId String
  createdAt  DateTime @default(now())

  @@unique([customerId, propertyId])
  @@index([customerId])
}

model Property {
  id              String   @id @default(cuid())
  title           String
  description     String
  location        String
  city            String
  neighborhood    String?
  address         String?
  price           Float
  priceUnit       String   // "sale", "monthly", "nightly"
  type            String   // "Villa", "Apartment", etc.
  listingType     String   // "Buy", "Rent", "Short Stay"
  bedrooms        Int
  bathrooms       Int
  area            Float
  rating          Float?   @default(0)
  reviewCount     Int?     @default(0)
  isFeatured      Boolean  @default(false)
  isSuperhost     Boolean  @default(false)
  isRareFind      Boolean  @default(false)
  isNew           Boolean  @default(false)
  isPremium       Boolean  @default(false)
  isGuestFavorite Boolean  @default(false)
  badge           String?
  amenities       String[]
  images          String[]
  host            Agent    @relation(fields: [hostId], references: [id])
  hostId          String
  status          String   @default("PENDING") // PENDING, PUBLISHED, REJECTED, SUSPENDED
  approvedAt      DateTime? // set the first time an admin publishes; lets owners re-publish their own suspended listings
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String
  propertyId  String?  
  agentId     String?  
  agent       Agent?   @relation(fields: [agentId], references: [id])
  isRead      Boolean  @default(false)
  repliedAt   DateTime? // set when an admin answers by email
  replies     InquiryReply[]
  createdAt   DateTime @default(now())
}

/// An emailed answer to a contact message, kept so the team can see what was said.
model InquiryReply {
  id        String   @id @default(cuid())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId String
  subject   String
  body      String   @db.Text
  sentBy    String // admin name at the time of sending
  sentTo    String
  createdAt DateTime @default(now())

  @@index([inquiryId])
}

/// Newsletter audience. Kept apart from Inquiry so the mailing list is its own
/// thing and contact messages stay a pure inbox.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  source         String    @default("footer") // where the signup came from
  lastEmailedAt  DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
}

model Payment {
  id              String   @id @default(cuid())
  orderRef        String   @unique
  amount          Float
  currency        String   @default("MZN")
  method          String   // "mpesa", "emola", "card"
  planType        String   // "standard", "premium", "pro", "boost"
  userId          String
  transactionId   String?
  customerName    String
  customerEmail   String
  customerPhone   String?
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  coverImage    String?
  category      String    @default("Market Insight")
  tags          String[]
  status        String    @default("DRAFT") // DRAFT, PUBLISHED
  isFeatured    Boolean   @default(false)
  readTime      Int       @default(4)
  author        Agent?    @relation(fields: [authorId], references: [id])
  authorId      String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   // dot-path into translations, e.g. "about.heading"
  lang      String   // "en" | "pt"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([key, lang])
  @@index([lang])
}

model PricingPlan {
  id            String   @id @default(cuid())
  slug          String   @unique // "standard", "premium", "pro", or an admin-defined key
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  highlighted   Boolean  @default(false)
  ctaMode       String   @default("checkout") // "checkout" -> /post-property, "contact" -> /contact
  nameEn        String
  namePt        String
  descriptionEn String
  descriptionPt String
  priceEn       String // free-form so admins can write "3,000 - 5,000" or "Grátis"
  pricePt       String
  unitEn        String
  unitPt        String
  badgeEn       String?
  badgePt       String?
  ctaEn         String
  ctaPt         String
  featuresEn    Json // [{ label: string, included: boolean, star: boolean }]
  featuresPt    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
}

model Advertisement {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  linkUrl     String?
  linkText    String?
  position    String   // "after_featured", "between_cities_1", "between_cities_2", "before_footer", "sidebar_strip"
  type        String   @default("banner") // "banner", "card_row", "strip"
  bgColor     String?  @default("#1a3c5e")
  textColor   String?  @default("#ffffff")
  accentColor String?  @default("#f4a61d")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
