# Copy to .env.production on the server and fill in the values from Vercel
# (Project -> Settings -> Environment Variables -> Production). Never commit it.
#
# Use EXACTLY the same JWT_SECRET / SESSION_SECRET as Vercel, or every app and
# website user is signed out.

# Database the live site uses (today: the Neon URL). Inside Docker, a
# PostgreSQL on the VPS itself is reached as host.docker.internal.
DATABASE_URL=

# Sign-in
JWT_SECRET=
SESSION_SECRET=

# Public (also baked into the website at build time)
NEXT_PUBLIC_BASE_URL=https://houseinmozambique.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_WHATSAPP=

# Images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_FROM_EMAIL=
VERIFY_FROM_EMAIL=
AUTH_FROM_EMAIL=
CONTACT_EMAIL=
ADMIN_EMAIL=

# Push notifications (the whole Firebase service-account JSON on ONE line,
# or base64 of it). Optional: without it nothing is pushed.
FIREBASE_SERVICE_ACCOUNT=

# Payments (if used)
MPESA_API_KEY=
MPESA_ENDPOINT=
EMOLA_API_KEY=
EMOLA_ENDPOINT=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Misc
MAINTENANCE_SECRET=
ANTHROPIC_API_KEY=
